# The student and teacher sites and the db scripts read these. Locally the default is a
# SQLite file at data/lemmory.db, so you don't need a .env file to develop.
# For production, set these in Vercel on the student and teacher sites (see DEPLOY.md):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...

# Only if your Vercel addresses differ from DEPLOY.md (or you use your own domain):
# NEXT_PUBLIC_TEACHER_URL=https://lemmory-teacher.vercel.app
# NEXT_PUBLIC_STUDENT_URL=https://lemmory-student.vercel.app

# Teacher site only: email (password-reset links and the weekly email to teachers).
# Without RESEND_API_KEY, local development prints emails to the terminal instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Lemmory <hello@yourdomain.com>
# The weekly email job refuses calls without "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET=a-long-random-string
