# The app (apps/app) and the db scripts read these. Locally the default is a SQLite
# file at data/lemmory.db, so you don't need a .env file to develop.
# For production, use a hosted libSQL database (Turso):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...

# The main site (apps/site): where Sign up / Log in point. Defaults to http://localhost:3001.
# NEXT_PUBLIC_APP_URL=https://app.lemmory.com
